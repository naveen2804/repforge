rules_version = '2';

// Every user owns exactly one subtree, users/{uid}, and can touch nothing outside it.
// Guests (anonymous sign-in) get a uid too, so the same rule covers them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
