# Baked into the static build. These only name the project; firestore.rules is what actually
# protects the data. The API key is not committed: CI passes it in from the
# VITE_FIREBASE_API_KEY repository secret, and local builds read it from .env.local.
VITE_FIREBASE_AUTH_DOMAIN=repforge2804.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=repforge2804
VITE_FIREBASE_APP_ID=1:704552360979:web:c035ad4004832b198bf3e6
VITE_AUTH_EMAIL_DOMAIN=repforge.invalid
